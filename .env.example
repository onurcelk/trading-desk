# --- Trading desk -----------------------------------------------------------
# Copy to .env and adjust. Every value here has a working default.

# Where the ledger and artifacts live.
TRADINGDESK_DB=./data/desk.sqlite3
TRADINGDESK_ARTIFACTS=./artifacts

# Opening balance of the simulated book.
TRADINGDESK_STARTING_CASH=100000

# Comma-separated coverage universe. Seeds the watchlist on first run only;
# after that the watchlist lives in the database and agents can edit it.
TRADINGDESK_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,AVGO,JPM,XOM,SPY

# --- Risk limits (enforced by the broker, not by agent judgement) -----------
TRADINGDESK_MAX_POSITION_PCT=0.20
TRADINGDESK_MAX_GROSS_PCT=1.00
TRADINGDESK_MIN_CASH_PCT=0.05
TRADINGDESK_MAX_ORDERS_PER_DAY=20
TRADINGDESK_MAX_HORIZON_DAYS=60

# --- Execution friction ------------------------------------------------------
TRADINGDESK_COMMISSION_PER_SHARE=0.005
TRADINGDESK_COMMISSION_MIN=1.00
TRADINGDESK_SLIPPAGE_BPS=5

# --- MCP server --------------------------------------------------------------
TRADINGDESK_MCP_HOST=127.0.0.1
TRADINGDESK_MCP_PORT=8010

# --- Market data -------------------------------------------------------------
# yfinance needs no key. fmp / tiingo / intrinio / polygon do — set the key
# below and switch the provider to use them.
TRADINGDESK_PROVIDER=yfinance
# OPENBB_FMP_API_KEY=
# OPENBB_TIINGO_API_KEY=
# OPENBB_INTRINIO_API_KEY=

# --- Paperclip registration (scripts/register_paperclip.py) -----------------
# PAPERCLIP_URL=http://localhost:3000
# PAPERCLIP_API_TOKEN=
# PAPERCLIP_COMPANY_ID=
